{
  "version": 2,
  "buildCommand": "npm --prefix frontend install && npm --prefix frontend run build",
  "outputDirectory": "frontend/dist",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/health",
      "destination": "/api/index.js"
    },
    {
      "source": "/api-docs(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/((?!api|health|api-docs).*)",
      "destination": "/index.html"
    }
  ]
}
