{
  "version": 2,
  "buildCommand": "node build.js",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/health",
      "destination": "/api/index.js"
    },
    {
      "source": "/api-docs(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/((?!api|health|api-docs).*)",
      "destination": "/index.html"
    }
  ]
}
