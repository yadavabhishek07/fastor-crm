{
  "name": "fastor-crm",
  "version": "1.0.0",
  "description": "Fastor CRM Lead Management System - Full Stack Application",
  "main": "backend/src/server.js",
  "scripts": {
    "install:all": "npm install && npm --prefix backend install && npm --prefix frontend install",
    "build": "npm --prefix frontend install && npm --prefix frontend run build",
    "start": "node backend/src/server.js",
    "start:backend": "cd backend && npm start",
    "dev:backend": "cd backend && npm run dev",
    "dev:frontend": "cd frontend && npm run dev",
    "test": "cd backend && npm test"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-validator": "^7.1.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.5.1",
    "morgan": "^1.10.0",
    "swagger-ui-express": "^5.0.1"
  },
  "author": "Abhishek Yadav",
  "license": "ISC",
  "devDependencies": {
    "vercel": "^65.8.0"
  }
}
